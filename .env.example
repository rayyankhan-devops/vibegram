# ==============================================================================
# VIBEGRAM — FULL-STACK ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file contains all environment configuration variables for VibeGram.
# Copy this file to .env before running the application:
#   cp .env.example .env
# ==============================================================================


# ==============================================================================
# 🗄️ 1. DATABASE TIER (DATA LAYER — MongoDB)
# ==============================================================================
# Connection URI and database name for the MongoDB instance.

# MongoDB Connection String (Format: mongodb://[username:password@]host[:port])
MONGODB_URI=mongodb://127.0.0.1:27017

# Name of the MongoDB database used by VibeGram
MONGODB_DATABASE=vibegram_db


# ==============================================================================
# ⚙️ 2. BACKEND TIER (APPLICATION LAYER — FastAPI / Python)
# ==============================================================================
# Server hosting, environment mode, and API routing configuration.

# Application environment (development | staging | production)
ENVIRONMENT=development

# Application name displayed in API health checks and docs
PROJECT_NAME="VibeGram API"

# API semantic version
VERSION=1.0.0

# Base prefix for all v1 REST API endpoints
API_V1_PREFIX=/api/v1

# Backend server bind host (127.0.0.1 for local, 0.0.0.0 for containers)
BACKEND_HOST=127.0.0.1

# Backend server listening port
BACKEND_PORT=8000


# ==============================================================================
# 🔐 3. SECURITY & AUTHENTICATION (Backend Security Layer)
# ==============================================================================
# Secret keys and settings for JSON Web Token (JWT) user authentication and CORS.

# Secret key used to sign and verify JWT authentication tokens (CHANGE IN PRODUCTION!)
JWT_SECRET=vibegram_dev_secret_key_change_in_production_9876543210_token_secret

# Cryptographic algorithm for JWT signature
JWT_ALGORITHM=HS256

# JWT token expiration duration in minutes (1440 mins = 24 hours)
JWT_EXPIRE_MINUTES=1440

# Comma-separated list of allowed Frontend origins for Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ==============================================================================
# 🎨 4. FRONTEND TIER (PRESENTATION LAYER — React 18 / Vite)
# ==============================================================================
# Variables prefixed with VITE_ are exposed to the client-side browser bundle.

# The base URL of the FastAPI Backend API consumed by the React Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
