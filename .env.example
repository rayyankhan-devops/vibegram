# ==============================================================================
# VibeGram Configuration Template
# Copy this file to .env and adjust values as needed for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration (MongoDB)
# ------------------------------------------------------------------------------
# MongoDB connection URI (standard connection string)
MONGODB_URI=mongodb://127.0.0.1:27017

# MongoDB database name for VibeGram data
MONGODB_DATABASE=vibegram_db

# ------------------------------------------------------------------------------
# Backend API Configuration (FastAPI)
# ------------------------------------------------------------------------------
# Host interface for FastAPI / Uvicorn server
BACKEND_HOST=127.0.0.1

# Port for FastAPI server
BACKEND_PORT=8000

# Environment mode: development, test, or production
ENVIRONMENT=development

# Allowed CORS origins (comma-separated list of URLs without trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# Secret key used for signing JWT access tokens (use a strong random string in production)
JWT_SECRET=vibegram_dev_secret_key_change_in_production_9876543210_token_secret

# JWT signing algorithm (HS256 is recommended for symmetric HMAC)
JWT_ALGORITHM=HS256

# JWT token expiration time in minutes (1440 minutes = 24 hours)
JWT_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------
# Base API URL prefix accessed by the frontend client
VITE_API_BASE_URL=http://localhost:8000/api/v1
