# ==============================================================================
# VIBEGRAM BACKEND TIER — ENVIRONMENT CONFIGURATION (FastAPI + MongoDB)
# ==============================================================================

# ------------------------------------------------------------------------------
# 🗄️ DATABASE CONFIGURATION (Data Tier — MongoDB)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g. mongodb://localhost:27017 or mongodb://mongo:27017 in Docker)
MONGODB_URI=mongodb://127.0.0.1:27017

# Name of the database in MongoDB
MONGODB_DATABASE=vibegram_db

# ------------------------------------------------------------------------------
# ⚙️ BACKEND SERVER CONFIGURATION (Application Tier — FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME="VibeGram API"
VERSION=1.0.0
API_V1_PREFIX=/api/v1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# 🔐 AUTHENTICATION & SECURITY CONFIGURATION (JWT & CORS)
# ------------------------------------------------------------------------------
JWT_SECRET=vibegram_dev_secret_key_change_in_production_9876543210_token_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
